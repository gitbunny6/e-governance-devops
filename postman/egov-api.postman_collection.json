{
  "info": {
    "name": "E-Governance API Tests",
    "description": "Automated API tests for the E-Governance Citizen Services Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health endpoint returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Health status is healthy', function () { pm.expect(pm.response.json().status).to.eql('healthy'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Citizen Services",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/services"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Services endpoint returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Four services are returned', function () { pm.expect(pm.response.json().services).to.have.lengthOf(4); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Submit Valid Application",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"citizen_name\":\"Test Citizen\",\"service_id\":1}"
        },
        "url": "{{baseUrl}}/api/applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Application is created with 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Application status is Submitted', function () { pm.expect(pm.response.json().application.status).to.eql('Submitted'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Reject Empty Citizen Name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"citizen_name\":\"\",\"service_id\":1}"
        },
        "url": "{{baseUrl}}/api/applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Invalid citizen name returns 400', function () { pm.response.to.have.status(400); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Reject Unknown Service",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"citizen_name\":\"Test Citizen\",\"service_id\":999}"
        },
        "url": "{{baseUrl}}/api/applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unknown service returns 404', function () { pm.response.to.have.status(404); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
